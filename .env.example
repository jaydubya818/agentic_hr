# Public (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Audit logging
# true keeps readable agent chat previews in audit_logs.details; unset defaults
# to previews outside production and sha256 digests in production
# (docs/SECURITY_AND_PRIVACY.md 8.2).
AUDIT_LOG_AGENT_CONTENT=

# Feature flags
USE_MOCK_DATA=true
USE_MOCK_AGENTS=true
USE_HRIS_READ=false
