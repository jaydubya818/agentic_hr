# Supply-chain hardening (Shai-Hulud/ChainDrop npm worm, Aug 2026).
# npm lifecycle scripts (preinstall/install/postinstall) are the worm's
# execution vector, so installs never run them. If a dependency genuinely
# needs its build script, review it and run `npm rebuild <package>`.
# Tradeoffs are documented in docs/SECURITY_AND_PRIVACY.md (section 14.2).
ignore-scripts=true
